# 本機設定的範本。不要手動複製：執行 `pnpm run initial`，它會用這個檔產生 .env.local，
# 並把 AUTH_SECRET 與 CRON_SECRET 填入隨機值（crypto.randomBytes，每台機器都不同）。
# pnpm dev／pnpm start 發現這兩個缺了也會自動隨機產生。切勿提交 .env.local。
#
# 除了那兩個以外，下面每一項都是**選填**：不填就用預設值，或那個功能停用。

# ── 必要（自動隨機產生，不要填固定值）──────────────────────────
AUTH_SECRET=""
# 保護 /api/cron/build 不被任意呼叫（pnpm worker 會自動帶上）
CRON_SECRET=""

# ── 資料庫：SQLite（libSQL）────────────────────────────────────
# 不填就是本機檔 ./data/ruincity.db（自動建立）。
# 部署到 Vercel 之類的 serverless 平台時檔案不保存，要用遠端 libSQL（例如 Turso）：
# DATABASE_URL="libsql://ruincity-<帳號>.turso.io"
# DATABASE_AUTH_TOKEN=""

# ── 繪製：平台的模型金鑰（捐款支付費用）────────────────────────
# 設了哪一家，哪一家就啟用；一把都沒有時只能用示範模式（見最下面）。
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# Claude 是勘查員：只寫地圖參數、不出圖、不參與投票（沒有它就由 Gemini 兼任）
# ANTHROPIC_API_KEY=""
# 沒有人投票時由誰畫：google（預設）| openai
# DEFAULT_PROVIDER="google"

# ── 參考影像：Street View Static API + Maps Static API ────────────
# 金鑰的 API 限制要開這兩個服務（不是 Maps JavaScript API）。
# ★ 上線前請先讀 docs/00-design.md §7 #1：Google Maps 條款限制以其內容建立新內容
# GOOGLE_MAPS_API_KEY=""

# ── 登入（選填）───────────────────────────────────────────────
# 都不填：開發模式下登入連結會印在終端機上，不需要 SMTP。
# Google OAuth：
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# Email（Gmail：使用者名稱是完整 email、`@` 寫成 %40、密碼用「應用程式密碼」）：
# EMAIL_SERVER="smtp://you%40gmail.com:apppassword@smtp.gmail.com:587"
# EMAIL_FROM="RuinCity <you@gmail.com>"

# ── 永久保存：Boltchain SwarmStorage（docs/00-design.md §10）──────────
# 不填：場景包照樣打包、照樣能從網站下載與驗證，只是不上鏈保存。
# BOLT_RPC_URL="http://127.0.0.1:8545"
# BOLT_STORAGE_RPC_URL=""                        # 開了 --rpc-storage 的平台節點；預設同上
# BOLT_PRIVATE_KEY=""                            # 付託管款的平台錢包（0x + 64 位十六進位）
# BOLT_CHAIN_ID=8018                             # 公開測試網
# BOLT_GATEWAYS="http://211.22.118.149:8080"     # 畫面上「從 Boltchain 閘道取回」的連結

# ── 示範模式（pnpm run initial --demo 會打開）─────────────────────
# 模型、街景、保存與金流全換成示範實作：不花錢、不連外，但帳照真的算。網站上方會一直顯示橫幅。
# FAKE_PROVIDERS=1
# PAYMENTS=demo

# 預算參數（匯率、手續費、S3 與 gas 參考價…）也可以用環境變數覆寫，
# 名稱與預設值見 lib/server/config.ts 與 lib/world/budget.ts。
