# 複製為 .env.local 後填入。切勿提交實際的值。

# ── 資料庫 ───────────────────────────────────────────────────
# Neon（正式環境）：
DATABASE_URL="postgresql://user:password@host.neon.tech/ruincity?sslmode=require"
# 本機 Postgres 也可以，driver 由 host 自動判斷（見 lib/db/driver.ts）：
#   docker run -e POSTGRES_PASSWORD=ruincity -p 5432:5432 -d postgres:17
#   DATABASE_URL="postgresql://postgres:ruincity@127.0.0.1:5432/postgres"

# ── Auth.js v5 ───────────────────────────────────────────────
# 產生：pnpm dlx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:5000"

# Google OAuth（選填；未設定時登入頁只顯示 Email）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email OTP（選填）
#
# ★ 開發時整段留空就好 —— 登入連結會印在跑 pnpm dev 的終端機上，
#   不需要一台能寄信的 SMTP。production build 不會有這個 fallback。
#
# 要用 Gmail 的話有兩個一定會踩到的地方：
#   1. 使用者名稱是**完整 email**，不是帳號名
#   2. 那個 `@` 在 URL 裡要 percent-encode 成 %40
#   3. 密碼要用「應用程式密碼」，不是登入密碼
# EMAIL_SERVER="smtp://you%40gmail.com:apppassword@smtp.gmail.com:587"
# EMAIL_FROM="RuinCity <you@gmail.com>"

# ── 排程 ─────────────────────────────────────────────────────
# 保護 /api/cron/* 不被任意呼叫
CRON_SECRET=""
