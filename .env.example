# 複製為 .env.local 後填入。切勿提交實際的值。

# ── 資料庫 ───────────────────────────────────────────────────
# Neon（正式環境）：
DATABASE_URL="postgresql://user:password@host.neon.tech/ruincity?sslmode=require"
# 本機 Postgres 也可以，driver 由 host 自動判斷（見 lib/db/driver.ts）：
#   docker run -e POSTGRES_PASSWORD=ruincity -p 5432:5432 -d postgres:17
#   DATABASE_URL="postgresql://postgres:ruincity@127.0.0.1:5432/postgres"

# ── Auth.js v5 ───────────────────────────────────────────────
# 產生：pnpm dlx auth secret
AUTH_SECRET=""
# ★ 埠是 5000（不是 Next 預設的 3000）。macOS 的 AirPlay 接收器預設就占用 5000，
#   關不掉的話用 PORT=5001 pnpm dev，並把下面這行一起改掉 ——
#   AUTH_URL 與實際的埠不一致時，magic link 的 callback 會導到一個沒人在聽的位址。
AUTH_URL="http://localhost:5000"

# Google OAuth（選填；未設定時登入頁只顯示 Email）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email OTP（選填）
#
# ★ 開發時整段留空就好 —— 登入連結會印在跑 pnpm dev 的終端機上，
#   不需要一台能寄信的 SMTP。production build 不會有這個 fallback。
#
# 要用 Gmail 的話有兩個一定會踩到的地方：
#   1. 使用者名稱是**完整 email**，不是帳號名
#   2. 那個 `@` 在 URL 裡要 percent-encode 成 %40
#   3. 密碼要用「應用程式密碼」，不是登入密碼
# EMAIL_SERVER="smtp://you%40gmail.com:apppassword@smtp.gmail.com:587"
# EMAIL_FROM="RuinCity <you@gmail.com>"

# ── 排程 ─────────────────────────────────────────────────────
# 保護 /api/cron/build 不被任意呼叫（pnpm worker 會自動帶上）
CRON_SECRET=""

# ── 繪製：平台的模型金鑰（捐款支付費用，不是捐款人的金鑰）──────────
# 設了哪一家，哪一家就啟用。Gemini 與 GPT Image 出現在投票選項裡；沒設的那一家「停用中」。
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Claude 是勘查員：只寫地圖參數、不出圖、不參與投票（沒有它就由 Gemini 兼任）
# 沒有人投票時由誰畫：google | openai
DEFAULT_PROVIDER="google"

# ── 參考影像：Google Street View Static API + Maps Static API ────────
# ★ 上線前請先讀 docs/00-design.md §7：Google Maps 條款限制以其內容建立新內容
GOOGLE_MAPS_API_KEY=""

# ── 示範模式（本機開發、展示、E2E）─────────────────────────────
# FAKE_PROVIDERS=1  三家模型與街景全換成示範實作：不花錢、不連外，但帳照真的算
# PAYMENTS=demo     示範金流：按一下就當作付款成功（不實際收款）
# 兩者開著時，網站上方會一直顯示「示範模式」橫幅
FAKE_PROVIDERS=""
PAYMENTS=""

# ── 世界地圖底圖（選填；預設 OpenFreeMap）──────────────────────
# 連不到外部圖磚的環境（離線展示、E2E）用 /map-style-blank.json
# MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"

# ── 預算參數（選填；預設值與理由見 lib/world/budget.ts）─────────────
# TWD_PER_USD=32
# PAYMENT_FEE_RATE=0.028
# PAYMENT_FEE_FIXED_TWD=5
# TAX_RATE=0.05
# CHARGEBACK_RATE=0.01
# STORAGE_USD_PER_GB_MONTH=0.015
# STORAGE_REPLICAS=2
# RETENTION_MONTHS=48
# COMPUTE_USD_PER_BLOCK=0.25
# PLATFORM_FEE_RATE=0
# RETRY_RESERVE_RATE=0.1
# VOLATILITY_RATE=0.05
