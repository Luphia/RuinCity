# 複製為 .env.local 後填入。切勿提交實際的值。

# ── 資料庫（Neon serverless Postgres）────────────────────────
DATABASE_URL="postgresql://user:password@host.neon.tech/ruincity?sslmode=require"

# ── Auth.js v5 ───────────────────────────────────────────────
# 產生：pnpm dlx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth（選填；未設定時登入頁只顯示 Email）
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email OTP（選填；nodemailer 連線字串）
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="RuinCity <noreply@ruincity.com>"

# ── 排程 ─────────────────────────────────────────────────────
# 保護 /api/cron/* 不被任意呼叫
CRON_SECRET=""
