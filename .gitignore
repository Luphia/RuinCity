# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ★ 但範本要進版控 —— 少了它，`cp .env.example .env.local`（README、CLAUDE.md
#   與 lib/env.ts 的錯誤訊息都這樣寫）在剛 clone 下來的機器上會直接失敗。
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/blob-report
/.playwright

# vitest
/coverage

# scratch
/.turbo

# 地形是由 seed 決定性生成的衍生物（pnpm map:generate）。
# 開發用的 s0 有進版控，讓 clone 下來就能跑 —— 才 364 KB。
# 正式賽季的地形在封盤期產生後上 CDN，不進這個 repo。
/public/terrain/*
!/public/terrain/s0/
