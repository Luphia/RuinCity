# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ★ 但範本要進版控 —— `pnpm run initial` 用它產生 .env.local（備份檔 .env.local.bak-* 也被上面那行擋掉）
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results
/playwright-report
/blob-report
/.playwright

# vitest
/coverage

# scratch
/.turbo

# 開發用的暫存腳本
/scratch-*.ts

# 本機 SQLite（DATABASE_URL 沒設時的預設位置）
/data/
