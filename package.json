{
  "name": "ruincity",
  "version": "0.2.0",
  "private": true,
  "description": "臺北 101 為中心、以 1km 為單位、由玩家自備 API 金鑰繪製的「人類離開一千年後」協作地圖遊戲",
  "scripts": {
    "dev": "next dev --port 5000",
    "build": "next build",
    "start": "tsx --tsconfig tsconfig.scripts.json scripts/start.ts",
    "start:web": "next start --port 5000",
    "worker": "tsx --tsconfig tsconfig.scripts.json scripts/worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@auth/drizzle-adapter": "1.11.3",
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "5.24.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "7.0.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5",
    "three": "0.186.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.186.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.33.0"
}
